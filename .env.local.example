# Local MySQL (when DATABASE_URL is not set — uses config/config.json development)
# For Docker dev, compose sets DATABASE_URL instead (same pattern as CRM/crm).

# Optional: Railway / production-style URL (overrides config.json when set)
# DATABASE_URL=mysql://root:password@127.0.0.1:3307/dialer_db

JWT_SECRET=change-me-to-a-long-random-string

# Optional: encrypt TOTP secrets at rest (AES-256-GCM). Falls back to JWT_SECRET if unset.
# TOTP_ENCRYPTION_KEY=change-me-to-a-long-random-totp-encryption-key
# Optional label shown in authenticator apps (default: Dialer)
# TOTP_ISSUER=Dialer
# Days to skip TOTP on a remembered browser after “Remember this device” (default: 7)
# TOTP_TRUST_DAYS=7

# Required for encrypting customer payment methods at rest (AES-256-GCM).
# Use a long random secret; changing it will make existing encrypted payment rows unreadable.
# If unset, JWT_SECRET is used as a fallback (not recommended for production).
PAYMENT_DATA_ENCRYPTION_KEY=change-me-to-a-long-random-payment-encryption-key

# Shift login window — defaults used until an admin saves settings on /shift (stored in DB).
# Env vars still apply on first boot before any DB row exists.
# Set LOGIN_WINDOW_ENABLED=false to disable enforcement without redeploying code.
# LOGIN_WINDOW_ENABLED=true
# LOGIN_WINDOW_START_UTC=13:00
# LOGIN_WINDOW_END_UTC=18:00

# Web3Forms — admin email alerts (location change on login, leave applications)
# Create access key at https://web3forms.com/ (admin inbox is set there)
# NEXT_PUBLIC_WEB3FORMS_ACCESS_KEY=your-access-key
# ADMIN_ALERT_EMAIL=admin@yourcompany.com
# LOCATION_ALERT_ENABLED=true
# LOCATION_CHANGE_KM=50
# LEAVE_APPLICATION_ALERT_ENABLED=true

# Resend — IVR email only on incoming call (gather choice/number = dialer realtime only). Server-only.
# https://resend.com — verify RESEND_FROM_EMAIL domain (or use onboarding@resend.dev for tests)
# RESEND_API_KEY=re_xxxxxxxx
# RESEND_FROM_EMAIL=alerts@yourdomain.com
# IVR_ALERT_EMAIL=admin@yourcompany.com,ops@yourcompany.com
# (comma or semicolon separated — multiple recipients supported)
# IVR_ALERT_ENABLED=true
# Optional shared secret for Studio HTTP widgets: ?secret=... or header x-ivr-secret
# IVR_WEBHOOK_SECRET=
# IVR_MAX_RING_TARGETS=5
# Total wait-loop window (seconds) before "all representatives are busy"
# IVR_DIAL_TIMEOUT_SEC=45
# Each <Dial> attempt inside the loop (seconds); shorter = faster retry when admin logs in
# IVR_DIAL_ATTEMPT_SEC=12
# Pause between Dial attempts when falling back without hold audio (seconds)
# IVR_WAIT_GAP_SEC=2
# Hold/queue chunk while no admin browser is online before rechecking (seconds)
# IVR_HOLD_CHUNK_SEC=8
# Hold/queue + between-attempt audio (defaults to {BASE}/sounds/ivr-ringback.mp3)
# IVR_RINGBACK_URL=https://dailer-production.up.railway.app/sounds/ivr-ringback.mp3
#
# Twilio Studio IVR webhooks (public HTTPS base required — not localhost without tunnel):
#   POST {BASE}/api/ivr/incoming   — right after Incoming Call (notify admin)
#   POST {BASE}/api/ivr/gather     — after each Gather (realtime choice/number)
#   Redirect {BASE}/api/ivr/connect — after IVR (hold + ring online admins)
#   Dial action {BASE}/api/ivr/dial-result — thanks Say only if unanswered; quiet hangup after conversation
# Studio Make HTTP Request — use HTTP Parameters (not JSON body). Widget names must match exactly.
# Do NOT HTTP after robot confirm (ask_associate) — UI should not show that step.
# Service menu widget: ask_associate_number (digits 0–3).
# After service press 0: ask_has_associate —
#   Say: If you are calling with an associate number, press 1. If not, press 2. To connect with an agent, press 0.
#   Split: 0 → connect_admin | 1 → connect_admin (or ask_number if you collect it) | 2 → ask_number → gather_number → connect_admin
#   Always HTTP gather_associate first so UI gets associate=0|1|2.
# gather_choice URL:  {BASE}/api/ivr/gather
#   Parameters: step=choice | choice={{widgets.ask_associate_number.Digits}} | from={{trigger.call.From}} | to={{trigger.call.To}} | callSid={{trigger.call.CallSid}}
# gather_associate URL: {BASE}/api/ivr/gather
#   Parameters: step=associate | choice={{widgets.ask_associate_number.Digits}} | associate={{widgets.ask_has_associate.Digits}} | from={{trigger.call.From}} | to={{trigger.call.To}} | callSid={{trigger.call.CallSid}}
# gather_number URL:  {BASE}/api/ivr/gather
#   Parameters: step=number | choice={{widgets.ask_associate_number.Digits}} | associate={{widgets.ask_has_associate.Digits}} | number={{widgets.ask_number.Digits}} | from={{trigger.call.From}} | to={{trigger.call.To}} | callSid={{trigger.call.CallSid}}
# connect_admin Redirect URL (backup so choice still saved if gather missed it):
#   {BASE}/api/ivr/connect?choice={{widgets.ask_associate_number.Digits}}&associate={{widgets.ask_has_associate.Digits}}&number={{widgets.ask_number.Digits}}&from={{trigger.call.From}}&to={{trigger.call.To}}&callSid={{trigger.call.CallSid}}
# Choice labels: 0=recent charge | 1=home theater | 2=receiver upgrades | 3=software services
# Associate labels: 0=connect agent | 1=has associate number | 2=no associate number
# Notifications also match Customers by caller From and by entered associate number.
# HTTP Success AND Fail → continue so IVR never stalls if notify fails.

# Default seeded admin (created automatically on first run)
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_PASSWORD=admin123456

# Twilio Configuration (aligned with CRM project)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
# Configure one call flow option (prefer App SID in production):
# TWILIO_APP_SID=APxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_TWIML_URL=https://your-public-domain.com/api/twilio/voice
# CRM-style webhook base URL (optional fallback used for /api/twilio/voice and /api/twilio/status):
# TWILIO_WEBHOOK_BASE_URL=https://your-public-domain.com
# Optional: call status webhook to sync status/duration to CallLogs
# TWILIO_STATUS_CALLBACK_URL=https://your-public-domain.com/api/twilio/status
# NOTE: localhost URLs won't work for Twilio webhooks. Use ngrok/cloudflared tunnel in local dev.

# Browser agents (Twilio Voice JS SDK) — each logged-in user registers as Client identity {prefix}_{userId}
# Create an API Key in Twilio Console. Outbound calls pass agentUserId in the voice webhook URL so the right agent rings.
# TWILIO_API_KEY_SID=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_API_KEY_SECRET=your_api_key_secret
# Optional prefix (default: agent). Identity format: {prefix}-{userId}-{username-slug}, e.g. agent-3-maryam
# TWILIO_AGENT_IDENTITY_PREFIX=agent
# Legacy single-identity fallback when the voice URL has no ?agentUserId= (not used with normal /api/calls/start)
# TWILIO_AGENT_CLIENT_IDENTITY=
# PSTN fallback if neither browser identity applies: TWILIO_AGENT_NUMBER
# Note: TWILIO_APP_SID TwiML apps use a fixed Voice URL — use TWILIO_WEBHOOK_BASE_URL (not App SID) for per-agent ?agentUserId= routing.

# Optional: test credentials / mode
# TWILIO_TEST_ACCOUNT_SID=
# TWILIO_TEST_AUTH_TOKEN=
# TWILIO_TEST_MODE=true
