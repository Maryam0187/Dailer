# Copy to .env.db-dump and fill in Railway production MySQL (public TCP proxy).
#   cp .env.db-dump.example .env.db-dump
#
# Use the public host/port — not *.railway.internal

PROD_MYSQL_HOST=crossover.proxy.rlwy.net
PROD_MYSQL_PORT=28400
PROD_MYSQL_USER=root
PROD_MYSQL_PASSWORD=your-password-here
PROD_MYSQL_DATABASE=railway
